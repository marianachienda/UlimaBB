<!-- views\website\reset-password.ejs -->

<% layout("layouts/access") %>


  <div class="container-fluid min-vh-100 d-flex justify-content-center align-items-start">

    <div class="login-form bg-white bg-opacity-90 p-5 mt-5">

      <!-- Logo -->
      <div class="text-center mb-4">
        <img
          src="assets/img/ulimaLogo.png"
          width="203"
          height="50"
          alt="Universidad de Lima"
        >
      </div>

      <!-- Título -->
      <div class="text-center mb-4">
        <h3>Recuperar Contraseña</h3>
        <p class="text-muted">
          Ingrese su correo electrónico para recibir instrucciones de recuperación.
        </p>
      </div>

      <!-- Correo -->
      <div class="mb-4">
        <label for="txtEmail" class="form-label">
          Correo electrónico
        </label>

        <input
          class="form-control"
          type="email"
          id="txtEmail"
          placeholder="ejemplo@ulima.edu.pe"
        >
      </div>

      <!-- Botón -->
      <div class="d-grid mb-3">
        <button type="button" class="btn btn-dark">
          Enviar enlace de recuperación
        </button>
      </div>

      <!-- Volver -->
      <div class="text-center mb-4">
        <a href="/login">
          Volver al inicio de sesión
        </a>
      </div>

      <!-- Mensaje informativo -->
      <div class="alert alert-secondary mb-4">
        Si el correo ingresado está registrado en el sistema, recibirá un enlace para restablecer su contraseña.
      </div>

      <!-- Copyright -->
      <div class="text-center">
        <small class="text-muted">
          © 1997-2026 Blackboard Inc. Todos los derechos reservados.
        </small>
      </div>

    </div>

  </div>

