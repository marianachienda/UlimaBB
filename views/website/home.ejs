<% layout("layouts/website") %>

<!-- =========================================================
     HERO SLIDER
========================================================= -->
<section class="bg-dark text-white">

  <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">

    <!-- Indicadores -->
    <div class="carousel-indicators">
      <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
      <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
      <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>

    <!-- Slides -->
    <div class="carousel-inner">

      <!-- SLIDE 1: Estudiantes -->
      <div class="carousel-item active">
        <div class="container-fluid" style="min-height: 550px; background: linear-gradient(90deg, rgba(11,12,16,0.95), rgba(11,12,16,0.7), rgba(11,12,16,0.3)), url('/assets/img/hero-campus.jpg') center/cover;">
          <div class="container d-flex align-items-center" style="min-height: 550px;">
            <div class="row">
              <div class="col-lg-8">
                <span class="badge mb-3 px-3 py-2 text-uppercase fw-semibold" style="background: rgba(255, 78, 80, 0.2); color: #ff4e50; border: 1px solid rgba(255, 78, 80, 0.3);">
                  Bolsa de Prácticas ULima
                </span>
                <h1 class="display-4 fw-bold mb-4">
                  Impulsa tu futuro profesional con <span class="gradient-text">PrácticaLima</span>
                </h1>
                <p class="lead text-light opacity-75 mb-4">
                  Encuentra las mejores oportunidades pre-profesionales y profesionales adaptadas a tu carrera en la Universidad de Lima.
                </p>
                <div class="d-flex flex-wrap gap-3">
                  <a href="/convocatorias" class="btn btn-danger-accent btn-lg px-4 fw-semibold">
                    <i class="bi bi-briefcase me-2"></i>Ver convocatorias
                  </a>
                  <a href="#about" class="btn btn-outline-light btn-lg px-4">
                    Conocer la plataforma
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- SLIDE 2: Empresas -->
      <div class="carousel-item">
        <div class="container-fluid" style="min-height: 550px; background: linear-gradient(90deg, rgba(11,12,16,0.95), rgba(11,12,16,0.7), rgba(11,12,16,0.3)), url('/assets/img/hero-office.jpg') center/cover;">
          <div class="container d-flex align-items-center" style="min-height: 550px;">
            <div class="row w-100">
              <div class="col-lg-8">
                <span class="badge mb-3 px-3 py-2 text-uppercase fw-semibold" style="background: rgba(249, 212, 35, 0.2); color: #f9d423; border: 1px solid rgba(249, 212, 35, 0.3);">
                  Para Empleadores
                </span>
                <h2 class="display-4 fw-bold mb-4">
                  Conecta con el mejor <span class="gradient-text">Talento ULima</span>
                </h2>
                <p class="lead mb-4 opacity-75">
                  Publica tus vacantes y llega directamente a estudiantes y egresados capacitados de diversas facultades.
                </p>
                <a href="/publicar" class="btn btn-danger-accent btn-lg px-4 fw-semibold">
                  <i class="bi bi-plus-circle me-2"></i>Publicar oferta
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- SLIDE 3: Filtros rápidos -->
      <div class="carousel-item">
        <div class="container-fluid" style="min-height: 550px; background: linear-gradient(90deg, rgba(11,12,16,0.95), rgba(11,12,16,0.7), rgba(11,12,16,0.3)), url('/assets/img/hero-students.jpg') center/cover;">
          <div class="container d-flex align-items-center" style="min-height: 550px;">
            <div class="row w-100">
              <div class="col-lg-8">
                <span class="badge mb-3 px-3 py-2 text-uppercase fw-semibold" style="background: rgba(255, 78, 80, 0.2); color: #ff4e50; border: 1px solid rgba(255, 78, 80, 0.3);">
                  Búsqueda Personalizada
                </span>
                <h2 class="display-4 fw-bold mb-4">
                  Tu primera práctica a <span class="gradient-text">un solo clic</span>
                </h2>
                <p class="lead mb-4 opacity-75">
                  Filtra por carrera, área de interés, modalidad de trabajo o ubicación para encontrar tu puesto ideal.
                </p>
                <a href="#search-section" class="btn btn-danger-accent btn-lg px-4 fw-semibold">
                  <i class="bi bi-search me-2"></i>Buscar vacantes
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Controles -->
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon"></span>
      <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon"></span>
      <span class="visually-hidden">Siguiente</span>
    </button>

  </div>

</section>

<!-- =========================================================
     BUSCADOR RÁPIDO
========================================================= -->
<section id="search-section" class="bg-light py-5">
  <div class="container">

    <div class="text-center mb-4">
      <span class="fw-bold text-uppercase" style="color: #ff4e50; letter-spacing: 1px;">Encuentra tu oportunidad</span>
      <h2 class="fw-bold mt-1">Buscador de convocatorias</h2>
      <p class="text-muted">Filtra entre cientos de vacantes activas para alumnos y egresados ULima</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-body p-4">
        <form action="/convocatorias" method="GET">
          <div class="row g-3">

            <!-- Palabras clave -->
            <div class="col-12 col-lg-4">
              <label class="form-label fw-semibold">Puesto o palabra clave</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                  <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" class="form-control border-start-0" name="search" placeholder="Ej. Practicante de Finanzas, UX...">
              </div>
            </div>

            <!-- Carrera -->
            <div class="col-12 col-md-4 col-lg-3">
              <label class="form-label fw-semibold">Carrera / Especialidad</label>
              <select name="carrera" class="form-select">
                <option value="">Todas las carreras</option>
                <option value="Administracion">Administración</option>
                <option value="Ingenieria Industrial">Ingeniería Industrial</option>
                <option value="Ingenieria de Sistemas">Ingeniería de Sistemas</option>
                <option value="Derecho">Derecho</option>
                <option value="Marketing">Marketing</option>
                <option value="Comunicacion">Comunicación</option>
                <option value="Economia">Economía</option>
              </select>
            </div>

            <!-- Modalidad -->
            <div class="col-12 col-md-4 col-lg-3">
              <label class="form-label fw-semibold">Modalidad</label>
              <select name="modalidad" class="form-select">
                <option value="">Todas</option>
                <option value="Presencial">Presencial</option>
                <option value="Hibrido">Híbrido</option>
                <option value="Remoto">Remoto</option>
              </select>
            </div>

            <!-- Botón -->
            <div class="col-12 col-md-4 col-lg-2 d-flex align-items-end">
              <button type="submit" class="btn btn-danger-accent w-100 py-2 fw-semibold">
                <i class="bi bi-funnel me-1"></i> Filtrar
              </button>
            </div>

          </div>
        </form>
      </div>
    </div>

  </div>
</section>

<!-- =========================================================
     ESTADÍSTICAS GENERALES
========================================================= -->
<section class="py-5">
  <div class="container">

    <div class="text-center mb-5">
      <span class="fw-bold text-uppercase" style="color: #ff4e50; letter-spacing: 1px;">Impacto Institucional</span>
      <h2 class="fw-bold mt-1">La plataforma en números</h2>
    </div>

    <div class="row g-4">

      <!-- Convocatorias -->
      <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100 text-center p-4 rounded-4">
          <div class="rounded-circle d-inline-flex align-items-center justify-center mx-auto mb-3" style="width: 65px; height: 65px; background: rgba(255,78,80,0.1); color: #ff4e50;">
            <i class="bi bi-briefcase-fill fs-3"></i>
          </div>
          <h3 class="fw-bold mb-1">
            <%= typeof convocatoriasCount !== 'undefined' ? convocatoriasCount : '180+' %>
          </h3>
          <p class="text-muted small mb-0">Convocatorias activas</p>
        </div>
      </div>

      <!-- Empresas -->
      <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100 text-center p-4 rounded-4">
          <div class="rounded-circle d-inline-flex align-items-center justify-center mx-auto mb-3" style="width: 65px; height: 65px; background: rgba(13,110,253,0.1); color: #0d6efd;">
            <i class="bi bi-building fs-3"></i>
          </div>
          <h3 class="fw-bold mb-1">
            <%= typeof empresasCount !== 'undefined' ? empresasCount : '95+' %>
          </h3>
          <p class="text-muted small mb-0">Empresas aliadas</p>
        </div>
      </div>

      <!-- Estudiantes -->
      <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100 text-center p-4 rounded-4">
          <div class="rounded-circle d-inline-flex align-items-center justify-center mx-auto mb-3" style="width: 65px; height: 65px; background: rgba(255,193,7,0.15); color: #ffc107;">
            <i class="bi bi-people-fill fs-3"></i>
          </div>
          <h3 class="fw-bold mb-1">
            <%= typeof estudiantesCount !== 'undefined' ? estudiantesCount : '3K+' %>
          </h3>
          <p class="text-muted small mb-0">Estudiantes postulando</p>
        </div>
      </div>

      <!-- Carreras -->
      <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100 text-center p-4 rounded-4">
          <div class="rounded-circle d-inline-flex align-items-center justify-center mx-auto mb-3" style="width: 65px; height: 65px; background: rgba(25,135,84,0.1); color: #198754;">
            <i class="bi bi-mortarboard-fill fs-3"></i>
          </div>
          <h3 class="fw-bold mb-1">
            <%= typeof carrerasCount !== 'undefined' ? carrerasCount : '12' %>
          </h3>
          <p class="text-muted small mb-0">Carreras profesionales</p>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- =========================================================
     SOBRE LA APLICACIÓN
========================================================= -->
<section id="about" class="py-5 text-white" style="background-color: #0b0c10;">
  <div class="container py-4">
    <div class="row align-items-center g-5">

      <div class="col-lg-6">
        <span class="badge mb-3 px-3 py-2 text-uppercase" style="background: rgba(255,78,80,0.2); color: #ff4e50; border: 1px solid rgba(255,78,80,0.3);">
          Sobre PrácticaLima
        </span>
        <h2 class="display-6 fw-bold mb-4">
          Conectamos a la comunidad ULima con el mercado laboral.
        </h2>
        <p class="text-secondary lead">
          PrácticaLima es el nexo directo entre los estudiantes de la Universidad de Lima y las mejores organizaciones del país.
        </p>
        <p class="text-secondary">
          Centralizamos oportunidades de prácticas pre-profesionales y profesionales con procesos transparentes, filtros rápidos por especialidad y acceso exclusivo para alumnos verificados.
        </p>
        <a href="/convocatorias" class="btn btn-danger-accent mt-3 px-4 py-2 fw-semibold">
          Explorar convocatorias
        </a>
      </div>

      <div class="col-lg-6">
        <div class="row g-3">

          <div class="col-6">
            <div class="card p-3 border-0 h-100" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255,255,255,0.08) !important;">
              <i class="bi bi-lightning-charge-fill fs-1" style="color: #ff4e50;"></i>
              <h5 class="mt-3 text-white">Postulación Ágil</h5>
              <p class="text-secondary small mb-0">Aplica a convocatorias en pocos pasos usando tu perfil universitario.</p>
            </div>
          </div>

          <div class="col-6">
            <div class="card p-3 border-0 h-100" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255,255,255,0.08) !important;">
              <i class="bi bi-shield-check fs-1" style="color: #f9d423;"></i>
              <h5 class="mt-3 text-white">Empresas Validadas</h5>
              <p class="text-secondary small mb-0">Ofertas de empresas verificadas que garantizan aprendizaje constante.</p>
            </div>
          </div>

          <div class="col-6">
            <div class="card p-3 border-0 h-100" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255,255,255,0.08) !important;">
              <i class="bi bi-sliders fs-1" style="color: #f9d423;"></i>
              <h5 class="mt-3 text-white">Filtros Precisos</h5>
              <p class="text-secondary small mb-0">Encuentra vacantes por carrera, modalidad y área de desempeño.</p>
            </div>
          </div>

          <div class="col-6">
            <div class="card p-3 border-0 h-100" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255,255,255,0.08) !important;">
              <i class="bi bi-bell-fill fs-1" style="color: #ff4e50;"></i>
              <h5 class="mt-3 text-white">Alertas Directas</h5>
              <p class="text-secondary small mb-0">Recibe avisos de nuevas publicaciones de tu interés académico.</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- =========================================================
     CTA FINAL
========================================================= -->
<section class="py-5">
  <div class="container py-3">
    <div class="rounded-4 p-5 text-center text-white shadow-lg" style="background: linear-gradient(135deg, #0b0c10 0%, #1f2833 100%); border: 1px solid rgba(255,255,255,0.1);">
      <i class="bi bi-rocket-takeoff-fill fs-1 gradient-text"></i>
      <h2 class="fw-bold mt-3">¿Listo para comenzar tu práctica?</h2>
      <p class="lead text-secondary mb-4 mx-auto" style="max-width: 600px;">
        Crea tu perfil con tu correo institucional ULima o inicia sesión para explorar las ofertas disponibles.
      </p>
      <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a href="/convocatorias" class="btn btn-danger-accent btn-lg px-4 fw-semibold">
          <i class="bi bi-search me-2"></i>Ver convocatorias
        </a>
        <a href="/register" class="btn btn-outline-light btn-lg px-4">
          Registrarme
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ESTILOS COMPLEMENTARIOS -->
<style>
  .gradient-text {
    background: linear-gradient(45deg, #ff4e50, #f9d423);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .btn-danger-accent {
    background: #ff4e50;
    color: #ffffff;
    border: none;
    transition: all 0.3s ease;
  }
  .btn-danger-accent:hover {
    background: #e04345;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(255, 78, 80, 0.4);
  }
</style>